diff -ruN a/libADLMIDI-1.6.2.1/src/chips/hook_opl2.cpp b/libADLMIDI-1.6.2.1/src/chips/hook_opl2.cpp
--- a/libADLMIDI-1.6.2.1/src/chips/hook_opl2.cpp
+++ b/libADLMIDI-1.6.2.1/src/chips/hook_opl2.cpp
@@ -0,0 +1,69 @@
+/*
+ * An OPL2 whose register writes go to a hook, see hook_opl2.h
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#include "hook_opl2.h"
+#include "../../include/adlmidi.h"
+#include <cstring>
+
+// One player at a time: the hook and the frames made so far are the library's
+static ADL_ChipWriteHook s_hook;
+static void *s_hookUserData;
+static unsigned long s_frame;
+
+void adl_hookOPL2Set(ADL_ChipWriteHook hook, void *userData)
+{
+    s_hook = hook;
+    s_hookUserData = userData;
+}
+
+unsigned long adl_hookOPL2Frame()
+{
+    return s_frame;
+}
+
+void HookOPL2::writeReg(uint16_t addr, uint8_t data)
+{
+    // an OPL2 has the first register set only
+    if(s_hook && addr < 0x100)
+        s_hook(s_hookUserData, addr, data, s_frame);
+}
+
+void HookOPL2::nativeGenerate(int16_t *frame)
+{
+    frame[0] = frame[1] = 0;
+    ++s_frame;
+}
+
+void HookOPL2::resampledGenerate(int32_t *frame)
+{
+    frame[0] = frame[1] = 0;
+    ++s_frame;
+}
+
+void HookOPL2::generate(int16_t *output, size_t frames)
+{
+    std::memset(output, 0, frames * 2 * sizeof(*output));
+    s_frame += frames;
+}
+
+void HookOPL2::generateAndMix(int16_t *, size_t frames)
+{
+    s_frame += frames;
+}
+
+void HookOPL2::generate32(int32_t *output, size_t frames)
+{
+    std::memset(output, 0, frames * 2 * sizeof(*output));
+    s_frame += frames;
+}
+
+void HookOPL2::generateAndMix32(int32_t *, size_t frames)
+{
+    s_frame += frames;
+}
diff -ruN a/libADLMIDI-1.6.2.1/src/chips/hook_opl2.h b/libADLMIDI-1.6.2.1/src/chips/hook_opl2.h
--- a/libADLMIDI-1.6.2.1/src/chips/hook_opl2.h
+++ b/libADLMIDI-1.6.2.1/src/chips/hook_opl2.h
@@ -0,0 +1,47 @@
+/*
+ * An OPL2 that is no emulator: its register writes go to a hook, for a real
+ * chip elsewhere (the FM chip of a MiSTer hybrid core), each with the output
+ * frame it is made at. It makes silence.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#ifndef HOOK_OPL2_H
+#define HOOK_OPL2_H
+
+#include "opl_chip_base.h"
+
+class HookOPL2 final : public OPLChipBase
+{
+    uint32_t m_pcmRate;
+public:
+    HookOPL2() : m_pcmRate(44100) {}
+    ~HookOPL2() override {}
+
+    bool canRunAtPcmRate() const override { return true; }
+    bool isRunningAtPcmRate() const override { return true; }
+    bool setRunningAtPcmRate(bool r) override { return r; }
+#if defined(ADLMIDI_AUDIO_TICK_HANDLER)
+    void setAudioTickHandlerInstance(void *) override {}
+#endif
+    void setRate(uint32_t rate) override { m_pcmRate = rate; }
+    uint32_t effectiveRate() const override { return m_pcmRate; }
+    void reset() override {}
+    void writeReg(uint16_t addr, uint8_t data) override;
+    void nativePreGenerate() override {}
+    void nativePostGenerate() override {}
+    void nativeGenerate(int16_t *frame) override;
+    void resampledGenerate(int32_t *frame) override;
+    void generate(int16_t *output, size_t frames) override;
+    void generateAndMix(int16_t *output, size_t frames) override;
+    void generate32(int32_t *output, size_t frames) override;
+    void generateAndMix32(int32_t *output, size_t frames) override;
+    const char *emulatorName() override { return "Hook OPL2"; }
+    ChipType chipType() override { return CHIPTYPE_OPL2; }
+    bool hasFullPanning() override { return false; }
+};
+
+#endif // HOOK_OPL2_H
